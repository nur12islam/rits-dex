{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RITS",
  "version": "0.1.0",
  "identifier": "online.darki.rits",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RITS — Desktop Assistant",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8765 http://localhost:5173 ws://localhost:5173; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "displayName": "RITS",
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/rits-backend.exe": "rits-backend.exe"
    }
  }
}
